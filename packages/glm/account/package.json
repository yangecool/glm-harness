{
  "name": "@glm-harness/gh-account",
  "description": "The GH account and project-token owner: OAuth authorization-code + PKCE over two service domains, single-flight refresh with per-caller cancellation, per-domain account epochs, and request-level short-term PAT resolution with rejection-driven invalidation",
  "version": "0.2.1-rc.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./service": {
      "types": "./lib/types/service.d.ts",
      "default": "./lib/index.js"
    },
    "./pat": {
      "types": "./lib/types/pat.d.ts",
      "default": "./lib/index.js"
    },
    "./oauth": {
      "types": "./lib/types/oauth.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  }
}
